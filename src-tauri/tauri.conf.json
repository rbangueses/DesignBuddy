{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesignBuddy",
  "version": "0.3.11",
  "identifier": "com.bangueses.designbuddy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DesignBuddy",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGRDIwNUUyNTkxMDNFMjEKUldRaFBoQlo0Z1hTVCtyM2YyWGVuTzF1Y0U3aHUrS3Z5YlIzWENsbThMRDlWOWhsdFZpM3pJSWUK",
      "endpoints": [
        "https://github.com/rbangueses/DesignBuddy/releases/latest/download/latest.json"
      ]
    }
  }
}
